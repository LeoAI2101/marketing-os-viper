# .local/env/.env.aws.prod — account AWS PRODUCTION, chỉ cho `--env PROD`
#
# FILE .example NÀY ĐƯỢC COMMIT (chỉ TÊN biến). Bản thật khớp mẫu `.env.*` nên .gitignore CHẶN SẴN.
#   cp .local/templates/.env.aws.prod.example .local/env/.env.aws.prod && chmod 600 .local/env/.env.aws.prod
#
# File ĐỘC LẬP, tự đủ khoá — không phủ lên .env.aws: `--env PROD` chỉ đọc file này nên không thể gọi
# Secrets Manager prod bằng khoá nonprod. Account STS trả về lệch AWS_SSO_ACCOUNT_ID → helper dừng.
#
# _CHƯA ĐIỀN_ — Authority bổ sung account, role, quy ước tên secret production.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=

AWS_SSO_START_URL=
AWS_SSO_REGION=
AWS_SSO_ACCOUNT_ID=
AWS_SSO_ROLE_NAME=

OPS_ENVS=PROD

SM_NAME_TEMPLATE=
SM_SERVICE_TYPE=
SM_APPLICATION_GROUP=

ECR_REGISTRY_ID=
ECR_REPOSITORY_TEMPLATE=
