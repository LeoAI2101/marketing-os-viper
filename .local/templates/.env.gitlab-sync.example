# .local/env/.env.gitlab-sync — đích + tài khoản cho adapter sync source sang repo con của pipeline
#
# FILE .example NÀY ĐƯỢC COMMIT (chỉ TÊN biến). Bản thật khớp mẫu `.env.*` nên .gitignore CHẶN SẴN.
#   cp .local/templates/.env.gitlab-sync.example .local/env/.env.gitlab-sync && chmod 600 .local/env/.env.gitlab-sync
#
# Đường dẫn con của từng target tra ở bảng deployment/gitlab-repo-map.tsv (commit, không bí mật) —
# không suy từ tên thư mục srcroot.
#
# _CHƯA ĐIỀN_ — Authority bổ sung host/nhóm GitLab.

GITLAB_HOST=
GITLAB_GROUP=
SYNC_BRANCH=main
# GitLab bật 2FA thì mật khẩu không đẩy được qua HTTPS — dùng Personal Access Token (write_repository)
# hoặc Deploy Token. Để trống cả hai → đi SSH bằng key sẵn có của máy.
GITLAB_USER=
GITLAB_TOKEN=
# ssh | https — trống: có token đi https, không có đi ssh
GITLAB_PROTO=
# 1 = chép hợp đồng sinh máy của target vào repo con dưới contracts/
SYNC_CONTRACTS=1
