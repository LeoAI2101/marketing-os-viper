# .local/env/.env.jenkins-prod — Jenkins PRODUCTION (khác Jenkins nonprod), chỉ cho `--env PROD`
#
# FILE .example NÀY ĐƯỢC COMMIT (chỉ TÊN biến). Bản thật khớp mẫu `.env.*` nên .gitignore CHẶN SẴN.
#   cp .local/templates/.env.jenkins-prod.example .local/env/.env.jenkins-prod && chmod 600 .local/env/.env.jenkins-prod
#
# Có file này thì `--env PROD` đọc NÓ thay `.env.jenkins`. Nguồn image (RC của PREPROD) vẫn đọc bằng
# `.env.jenkins` — hai Jenkins dùng song song.
#
# _CHƯA ĐIỀN_ — Authority bổ sung khi có link Jenkins prod chính thức.

JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_TOKEN=
JENKINS_JOB_PATH=
