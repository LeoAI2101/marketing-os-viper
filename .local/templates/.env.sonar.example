# .local/env/.env.sonar — SonarQube, lớp ĐỐI CHIẾU trên server của skill code-quality-gate
#
# FILE .example NÀY ĐƯỢC COMMIT (chỉ TÊN biến). Bản thật khớp mẫu `.env.*` nên .gitignore CHẶN SẴN.
#   cp .local/templates/.env.sonar.example .local/env/.env.sonar && chmod 600 .local/env/.env.sonar
#
# Ngưỡng là của `.claude/skills/code-quality-gate` — `make check` phải fail đúng thứ Sonar sẽ fail.
# Sonar không phải nguồn ngưỡng thứ hai.

# SONAR_HOST_URL không có dấu / ở cuối; SONAR_TOKEN là User Token
SONAR_HOST_URL=
SONAR_TOKEN=
# Chỉ SonarCloud mới cần
SONAR_ORGANIZATION=
# Mỗi target một project: <PREFIX>-<tên target>. Gộp chung thì một target đỏ kéo cả hệ đỏ.
SONAR_PROJECT_KEY_PREFIX=
SONAR_PROJECT_NAME_PREFIX=
# Ghi đè key lệch quy tắc: "tên=key tên2=key2"
SONAR_PROJECT_KEY_MAP=
# Project token riêng: "tên=token" — thắng SONAR_TOKEN chung cho target đó
SONAR_TOKEN_MAP=
# true = chờ quality gate rồi mới thoát (CI)
SONAR_QUALITYGATE_WAIT=false
# Để trống trên Community Build — bản Community từ chối cả lượt quét khi có sonar.branch.name
SONAR_BRANCH=
SONAR_SCANNER_OPTS=
