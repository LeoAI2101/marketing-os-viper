# .local/env/.env.jenkins — Jenkins NONPROD (SIT · UAT · PT · PREPROD)
#
# FILE .example NÀY ĐƯỢC COMMIT (chỉ TÊN biến). Bản thật khớp mẫu `.env.*` nên .gitignore CHẶN SẴN.
#   cp .local/templates/.env.jenkins.example .local/env/.env.jenkins && chmod 600 .local/env/.env.jenkins
#
# _CHƯA ĐIỀN_ — Authority bổ sung URL, đường job thật (deployment/DEPLOY-WORKFLOW.md §Jenkins).

# --- Đăng nhập: JENKINS_USER là USER ID trong Jenkins (không phải email); JENKINS_TOKEN là API Token ---
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_TOKEN=

# --- Đường tới job. Chỗ giữ: {env} (HOA) · {group} (nhóm srcroot) · {target} · {service} ---
JENKINS_JOB_PATH=
# Đường riêng theo nhóm srcroot (thắng JENKINS_JOB_PATH): JENKINS_JOB_PATH_<NHÓM HOA, - → _>=…
# JENKINS_JOB_PATH_BOUNDARIES=
# JENKINS_JOB_PATH_WEB_EXPERIENCES=

# --- Môi trường ---
OPS_ENVS=
# Env tạo release candidate — bắt buộc --rc-tag
JENKINS_ENVS_REQUIRE_RC_TAG=
# Env đích bắt buộc chọn nguồn image bằng --source-env
JENKINS_ENVS_REQUIRE_SOURCE_ENV=
