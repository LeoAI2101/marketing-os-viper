# .local/env/.env.aws — thông tin xác thực + quy ước AWS cho các môi trường NONPROD
#
# FILE .example NÀY ĐƯỢC COMMIT (chỉ TÊN biến). Bản thật `.local/env/.env.aws` khớp mẫu
# `.env.*` nên .gitignore CHẶN SẴN — luật #6, không secret trong code.
#   cp .local/templates/.env.aws.example .local/env/.env.aws && chmod 600 .local/env/.env.aws
#
# _CHƯA ĐIỀN_ — Authority bổ sung: region, account, quy ước tên secret, ECR (deployment/DEPLOY-WORKFLOW.md §AWS).

# --- Thông tin đăng nhập (khoá tạm STS thì có AWS_SESSION_TOKEN) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=

# --- AWS IAM Identity Center (SSO), tuỳ chọn — điền đủ bốn dòng hoặc bỏ trống cả bốn ---
AWS_SSO_START_URL=
AWS_SSO_REGION=
AWS_SSO_ACCOUNT_ID=
AWS_SSO_ROLE_NAME=

# --- Môi trường có account AWS RIÊNG (vd PREPROD): khoá hậu tố _<ENV> thắng khoá chung ---
# Khai AWS_SSO_ACCOUNT_ID_<ENV> là báo env đó có account riêng: ba khoá STS CHỈ lấy từ *_<ENV>,
# thiếu thì dừng — không mượn khoá chung (mượn là gọi Secrets Manager nhầm account).
# AWS_SSO_ACCOUNT_ID_PREPROD=
# AWS_ACCESS_KEY_ID_PREPROD=
# AWS_SECRET_ACCESS_KEY_PREPROD=
# AWS_SESSION_TOKEN_PREPROD=

# --- Môi trường đã có trên Secrets Manager (chỉ nhận đúng tên khai ở đây) ---
OPS_ENVS=

# --- Quy ước tên secret. Chỗ giữ: {env} {service_type} {application_group} {target} ---
SM_NAME_TEMPLATE=
SM_SERVICE_TYPE=
SM_APPLICATION_GROUP=
# Ngoại lệ từng target: SM_NAME_<TÊN TARGET HOA, - → _>=…

# --- ECR (chỉ đọc tag image) ---
ECR_REGISTRY_ID=
ECR_REPOSITORY_TEMPLATE=
